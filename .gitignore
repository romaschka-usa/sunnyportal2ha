zugangsdaten.ini
*.ini
!zugangsdaten.ini.beispiel

# ---------------------------------------------------------------------------
# Exportierte Messdaten
# Das sind die Verbrauchs- und Erzeugungsdaten des Anlagenbetreibers.
# Sie gehoeren nicht in ein oeffentliches Repository, und Git ist fuer
# hunderte Megabyte ohnehin das falsche Werkzeug.
# ---------------------------------------------------------------------------
bilanz/
bilanz_tage/
bilanz_monate/
bilanz_jahre/
wechselrichter/
wechselrichter_tage/
wechselrichter_monate/
wechselrichter_jahre/
rohdaten/
export_log.json
export_protokoll.json

# Die Ergebnisse der Stufen 2 bis 4. Ebenfalls Messdaten - und dazu
# anlagenspezifische Entscheidungen, die jede Anlage selbst treffen muss.
ha/
import/
geraeteregeln.json
plausibilitaet.json

# Das Laufprotokoll. Es enthaelt zwar keine Messwerte und darf einem
# Fehlerbericht beiliegen - aber es ist die Ausgabe eines Laufs und kein Code.
export-log.txt

# ---------------------------------------------------------------------------
# Hilfsskripte und ihre Ausgaben aus der Entwicklungsphase
# ---------------------------------------------------------------------------
analyse/

# ---------------------------------------------------------------------------
# Altbestand: frueherer Anlauf. Enthaelt unter anderem Zugangsdaten im
# Klartext in einer .pyc-Datei - dieser Ordner darf das Repository niemals
# erreichen.
# ---------------------------------------------------------------------------
_alt/
Test-SMA/

# ---------------------------------------------------------------------------
