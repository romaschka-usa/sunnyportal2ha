; Vorlage fuer die Zugangsdaten des Sunny-Portal-Kontos.
;
; Diese Datei nach  zugangsdaten.ini  kopieren und ausfuellen.
; zugangsdaten.ini steht in der .gitignore und darf niemals eingecheckt werden.
;
; Es werden die normalen Anmeldedaten von sunnyportal.com verwendet,
; also die der SMA ID. Die Skripte lesen ausschliesslich.

[sunnyportal]
benutzer = deine@mailadresse.de
passwort = deinPasswort

; Wie viele Verbindungen der Export gleichzeitig oeffnen darf.
; Das Portal erlaubt parallele Anmeldungen; jeder Arbeiter meldet sich
; eigenstaendig an. Vier bis sechs sind ein vernuenftiger Bereich - es ist
; der Server eines Herstellers, nicht der eigene. Ohne Eintrag: 3.
[export]
parallel = 5

; Zeitbudget je Aufgabe in Sekunden. Gilt als Zeitlimit je Anfrage und als
; Obergrenze dafuer, wie lange ein Arbeiter an einem Monat oder Tag sitzt.
timeout = 300

; Home Assistant, noetig fuer die Stufen 2 und 4.
; Das Token erzeugt man in HA unter
; Benutzername (unten links) -> Sicherheit -> Langlebige Zugriffstoken.
[homeassistant]
url = http://192.168.x.y
token = dein-langlebiges-token
